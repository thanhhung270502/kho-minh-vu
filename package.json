{
  "name": "kiotviet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:link": "supabase link --project-ref $SUPABASE_PROJECT_ID",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && supabase test db",
    "db:test:linked": "supabase test db --linked",
    "db:types:local": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "verify:hook": "tsx scripts/verify-hook.ts",
    "import:kiotviet": "tsx scripts/import-kiotviet/index.ts",
    "import:mau": "tsx scripts/import-kiotviet/tao-du-lieu-mau.ts",
    "test:dong-thoi": "bash scripts/test-dong-thoi.sh"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "supabase": "^2.117.0",
    "tsx": "^4.19.2",
    "dotenv": "^16.4.7"
  }
}
