# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local đã nằm trong .gitignore — tuyệt đối không commit.

# ─────────────────────────────────────────────────────────────────────────────
# 1. ỨNG DỤNG WEB (gửi xuống trình duyệt — chỉ đặt giá trị KHÔNG bí mật)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dashboard > Project Settings > API > Project API keys > anon / public
# Khóa này lộ ra trình duyệt là bình thường, an toàn nhờ Row Level Security.
# TUYỆT ĐỐI không đặt service_role key vào biến NEXT_PUBLIC_* — làm vậy là mất
# sạch quyền kiểm soát database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. CÔNG CỤ DÒNG LỆNH (không gửi xuống trình duyệt)
# ─────────────────────────────────────────────────────────────────────────────
# Mã project, phần sau https:// và trước .supabase.co trong URL ở trên.
# Dùng cho: npm run db:link, db:push, db:types
SUPABASE_PROJECT_ID=

# Mật khẩu database, đặt lúc tạo project.
# Dashboard > Project Settings > Database > Database password (Reset nếu quên).
# Dùng cho: npm run db:push
SUPABASE_DB_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SCRIPT QUẢN TRỊ (service_role — BỎ QUA MỌI RLS)
# ─────────────────────────────────────────────────────────────────────────────
# Dashboard > Project Settings > API > Project API keys > service_role > Reveal
#
# Khóa này bỏ qua toàn bộ phân quyền. Chỉ dùng cho hai script:
#   npm run seed:users        — tạo 4 tài khoản mẫu
#   npm run import:kiotviet   — nạp 3.266 mã hàng
#
# Trong src/ CHỈ được đọc ở src/lib/env-server.ts (đánh dấu server-only) cho màn
# Cài đặt → Người dùng: tạo tài khoản, đặt lại mật khẩu, thu hồi phiên.
# TUYỆT ĐỐI không đặt vào biến NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu cho 5 tài khoản mẫu do seed:users tạo.
# Đổi ngay sau khi tạo, hoặc xóa các tài khoản này trước khi go-live.
SEED_USER_PASSWORD=MatKhauDemo123!

# Mật khẩu TẠM cho tài khoản nhân viên thật do seed:users tạo (bắt buộc).
# Nhân viên bị bắt đổi mật khẩu ở lần đăng nhập đầu. Không commit giá trị thật.
STAFF_INITIAL_PASSWORD=

# Tài khoản các script NẠP DỮ LIỆU đăng nhập để ghi chứng từ qua RLS
# (import-chung-tu-excel, import-lich-su-excel, import-ma-hang-sheet).
# Bắt buộc khi chạy với --ghi; KHÔNG dùng mật khẩu demo ở trên — script nạp chạy
# trên database thật. Dùng tài khoản quản lý có quyền ghi chứng từ / tạo mã hàng.
IMPORT_USER_EMAIL=
IMPORT_USER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 4. TEST ĐỒNG THỜI (npm run test:dong-thoi)
# ─────────────────────────────────────────────────────────────────────────────
# Chuỗi kết nối Postgres trực tiếp, cần hai kết nối giữ transaction mở —
# supabase-js không làm được việc này.
#
# Lấy ở đâu: Dashboard > nút "Connect" (góc trên) > tab "Session pooler"
# hoặc "Direct connection" > copy URI, thay [YOUR-PASSWORD] bằng mật khẩu DB.
#
# PHẢI dùng Session pooler hoặc Direct (cổng 5432).
# Transaction pooler (cổng 6543) không giữ được khóa giữa các câu lệnh.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 5. TRIỂN KHAI TRÊN VERCEL — bảng đối chiếu tên biến
# ─────────────────────────────────────────────────────────────────────────────
# Supabase integration trên Vercel tự tạo một bộ biến với TÊN KHÁC file này.
# Code đã đọc được cả hai bộ, nên KHÔNG cần khai trùng:
#
#   File này (local)              Vercel (integration tự tạo)
#   ────────────────────────────  ──────────────────────────────────────
#   NEXT_PUBLIC_SUPABASE_ANON_KEY NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY     SUPABASE_SECRET_KEY
#
# NGOẠI LỆ — phải tự thêm tay trong Vercel > Settings > Environment Variables:
#
#   NEXT_PUBLIC_SUPABASE_URL
#
# Integration chỉ tạo `SUPABASE_URL` (không có tiền tố NEXT_PUBLIC_). Next.js
# chỉ nhúng biến NEXT_PUBLIC_* vào bundle trình duyệt, nên thiếu biến này thì
# trang trắng ngay khi mở: "NEXT_PUBLIC_SUPABASE_URL phải là URL hợp lệ".
# Giá trị lấy đúng bằng giá trị của SUPABASE_URL mà integration đã tạo.
#
# Các biến POSTGRES_*, SUPABASE_JWT_SECRET, SUPABASE_ANON_KEY do integration
# tạo ra: app không dùng tới, cứ để nguyên.

# ─────────────────────────────────────────────────────────────────────────────
# 6. LƯU ẢNH MÃ HÀNG (Google Drive qua Apps Script — CHỈ SERVER)
# ─────────────────────────────────────────────────────────────────────────────
# Thiết lập theo apps-script/README.md. Hai biến này TUYỆT ĐỐI không có tiền tố
# NEXT_PUBLIC_: lộ secret là ai cũng ghi/xóa được file trên Drive của hệ thống.
# Trên Vercel khai tay cùng tên ở Settings > Environment Variables.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 7. ĐỒNG BỘ BỘ MÃ HÓA (Quy chuẩn mã — CHỈ SERVER)
# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron gọi /api/cron/ma-hoa mỗi ngày (vercel.json) kèm
# "Authorization: Bearer <CRON_SECRET>". Thiếu CRON_SECRET thì route trả 503.
# Sinh: openssl rand -hex 32. Trên Vercel khai tay ở Settings > Environment Variables.
CRON_SECRET=
# Hai link CSV lấy bằng: Google Sheet > Tệp > Chia sẻ > Xuất bản lên web > chọn
# ĐÚNG TAB > "Giá trị được phân tách bằng dấu phẩy (.csv)" > Xuất bản > copy link
# (dạng https://docs.google.com/spreadsheets/d/e/2PACX-…/pub?gid=…&single=true&output=csv).
# Không có giá trị mặc định trong code — thiếu thì tính năng tương ứng báo chưa cấu hình.
#
# Tab quy chuẩn mã: dòng 1 đúng 10 tiêu đề 1.HÃNG XE | MÃ HÓA | 2.DÒNG XE | MÃ HÓA |
# 4.LINH KIỆN | MÃ HÓA | 5.XỬ LÝ | MÃ HÓA | 6.MÀU | MÃ HÓA. Job 5h sáng đồng bộ vào ma_hoa.
MA_HOA_SHEET_CSV_URL=
# Tab tên hàng chuẩn: 2 cột mã hàng, tên hàng — KHÔNG có dòng tiêu đề. Dùng để tự
# điền Tên hàng ở Thêm mã hàng / Nhập mã hàng mới.
TEN_HANG_SHEET_CSV_URL=
