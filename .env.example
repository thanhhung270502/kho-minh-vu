# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy tại: Supabase Dashboard > Project Settings > API

# URL của project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Khoá công khai (anon / publishable). Khoá này lộ ra trình duyệt là bình thường,
# an toàn nhờ Row Level Security. TUYỆT ĐỐI không đặt service_role key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mã project, dùng cho lệnh `npm run db:types` để sinh lại TypeScript types.
SUPABASE_PROJECT_ID=
